{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)seo' ':(exclude).github' ':(exclude).vercelignore'",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reisapp.cz"
        }
      ],
      "destination": "https://reisapp.cz/:path*",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/obory",
      "destination": "/navody/obory",
      "permanent": true
    },
    {
      "source": "/navod",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        },
        {
          "type": "query",
          "key": "device",
          "value": "(?<device>.+)"
        },
        {
          "type": "query",
          "key": "browser",
          "value": "(?<browser>.+)"
        }
      ],
      "destination": "/en/navod?device=:device&browser=:browser",
      "permanent": true
    },
    {
      "source": "/navod",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        },
        {
          "type": "query",
          "key": "device",
          "value": "(?<device>.+)"
        }
      ],
      "destination": "/en/navod?device=:device",
      "permanent": true
    },
    {
      "source": "/navod",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        },
        {
          "type": "query",
          "key": "browser",
          "value": "(?<browser>.+)"
        }
      ],
      "destination": "/en/navod?browser=:browser",
      "permanent": true
    },
    {
      "source": "/navod",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/navod",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rx/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path"
    }
  ]
}
