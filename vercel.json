{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "reis-navod.cz" }],
      "destination": "/navod",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.reis-navod.cz" }],
      "destination": "/navod",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/rx/:path(.*)", "destination": "https://eu.i.posthog.com/:path" }
  ]
}
