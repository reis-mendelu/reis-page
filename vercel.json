{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reis-navod.cz"
        }
      ],
      "destination": "https://reisapp.cz/navod",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reisapp.cz"
        }
      ],
      "destination": "https://reisapp.cz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rx/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path"
    }
  ]
}
